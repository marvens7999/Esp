----------------------------------------------------------------------
-- MINIMAP MAP SCAN
----------------------------------------------------------------------
local DETAIL = { Low = 28, Medium = 40, High = 52 }
local PLANE_FACTOR = 1.5

local VOID  = Color3.fromRGB(12, 12, 20)
local WATER = Color3.fromRGB(35, 105, 200)
local GREYC = Color3.fromRGB(120, 120, 120)
local LIGHT = Vector3.new(-0.45, 0.8, -0.4).Unit

local mapRayParams = RaycastParams.new()
mapRayParams.FilterType  = Enum.RaycastFilterType.Exclude
mapRayParams.IgnoreWater = false
pcall(function() mapRayParams.RespectCanCollide = true end)

local function refreshFilter()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then list[#list + 1] = p.Character end
    end
    mapRayParams.FilterDescendantsInstances = list
end

local mapColor, mapTime, cacheCount = {}, {}, 0
local cells, cellColor = {}, {}
local gridN, cellPx, cellStuds = 0, 1, 1
local cx0, cz0 = 0, 0
local rr = 0
local needRecolor = true
local laidSize, laidRange, laidTransp
local seenSize, seenRange, stableSince = Config.RadarSize, Config.RadarRange, 0
local lastFilter = -10

local function keyOf(wx, wz)
    return (wx + 32768) * 65536 + (wz + 32768)
end

local function layoutGrid()
    cellPx    = Config.RadarSize * PLANE_FACTOR / gridN
    cellStuds = (PLANE_FACTOR * 2) * Config.RadarRange / gridN
    Plane.Size = UDim2.fromOffset(cellPx * gridN, cellPx * gridN)
    local sz = UDim2.fromOffset(math.ceil(cellPx) + 1, math.ceil(cellPx) + 1)
    for a = 0, gridN - 1 do
        for b = 0, gridN - 1 do
            local f = cells[a * gridN + b + 1]
            f.Size = sz
            f.Position = UDim2.fromOffset(a * cellPx, b * cellPx)
        end
    end
    laidSize, laidRange = Config.RadarSize, Config.RadarRange
    seenSize, seenRange = laidSize, laidRange
    mapColor, mapTime, cacheCount = {}, {}, 0
    cellColor = {}
    needRecolor = true
end

local function buildGrid(n)
    for _, f in ipairs(cells) do f:Destroy() end
    cells, cellColor = {}, {}
    gridN = n
    laidTransp = Config.MapTransparency
    for a = 0, n - 1 do
        for b = 0, n - 1 do
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.BackgroundColor3 = VOID
            f.BackgroundTransparency = laidTransp
            f.Parent = Plane
            cells[a * n + b + 1] = f
        end
    end
    layoutGrid()
end

local function sampleCell(wx, wz, refY)
    local x, z = (wx + 0.5) * cellStuds, (wz + 0.5) * cellStuds
    local res = Workspace:Raycast(Vector3.new(x, refY + 150, z), Vector3.new(0, -700, 0), mapRayParams)
    if not res then return VOID end

    local inst, mat = res.Instance, res.Material
    local col
    if mat == Enum.Material.Water then
        col = WATER
    elseif inst and inst:IsA("Terrain") then
        local ok, c = pcall(function() return Terrain:GetMaterialColor(mat) end)
        col = ok and c or Color3.fromRGB(110, 130, 90)
    elseif inst and inst:IsA("BasePart") then
        col = inst.Color
    else
        col = GREYC
    end

    local light = 0.72 + 0.28 * math.clamp(res.Normal:Dot(LIGHT), -1, 1)
    local hgt   = math.clamp(0.82 + (res.Position.Y - refY) / 140, 0.5, 1.3)
    local k     = light * hgt
    return Color3.new(math.clamp(col.R * k, 0, 1), math.clamp(col.G * k, 0, 1), math.clamp(col.B * k, 0, 1))
end

local function updateMap(ctx)
    if not (Config.Enabled and Config.Radar and Config.RadarMap) then
        Plane.Visible = false
        return
    end
    Plane.Visible = true

    local n = DETAIL[Config.MapDetail] or 40
    if n ~= gridN then buildGrid(n) end

    if Config.RadarSize ~= laidSize or Config.RadarRange ~= laidRange then
        if Config.RadarSize ~= seenSize or Config.RadarRange ~= seenRange then
            seenSize, seenRange, stableSince = Config.RadarSize, Config.RadarRange, ctx.t
        elseif ctx.t - stableSince > 0.3 then
            layoutGrid()
        end
    end

    if Config.MapTransparency ~= laidTransp then
        laidTransp = Config.MapTransparency
        for i = 1, #cells do cells[i].BackgroundTransparency = laidTransp end
    end

    if ctx.t - lastFilter > 2 then
        lastFilter = ctx.t
        refreshFilter()
    end

    local px, py, pz = ctx.ppos.X, ctx.ppos.Y, ctx.ppos.Z
    local pcx, pcz = math.floor(px / cellStuds), math.floor(pz / cellStuds)
    local total = gridN * gridN

    local ncx0, ncz0 = pcx - gridN / 2, pcz - gridN / 2
    if ncx0 ~= cx0 or ncz0 ~= cz0 or needRecolor then
        cx0, cz0 = ncx0, ncz0
        needRecolor = false
        for idx = 1, total do
            local i0 = idx - 1
            local a = math.floor(i0 / gridN)
            local b = i0 - a * gridN
            local col = mapColor[keyOf(cx0 + a, cz0 + b)] or VOID
            if cellColor[idx] ~= col then
                cellColor[idx] = col
                cells[idx].BackgroundColor3 = col
            end
        end
    end

    local K = math.max(24, math.floor(total / 24))
    for _ = 1, K do
        rr = rr % total + 1
        local i0 = rr - 1
        local a = math.floor(i0 / gridN)
        local b = i0 - a * gridN
        local wx, wz = cx0 + a, cz0 + b
        local key = keyOf(wx, wz)
        local col = mapColor[key]
        if not col or ctx.t - (mapTime[key] or 0) > 12 then
            col = sampleCell(wx, wz, py)
            if not mapColor[key] then cacheCount += 1 end
            mapColor[key], mapTime[key] = col, ctx.t
        end
        if cellColor[rr] ~= col then
            cellColor[rr] = col
            cells[rr].BackgroundColor3 = col
        end
    end
    if cacheCount > 40000 then
        mapColor, mapTime, cacheCount = {}, {}, 0
        needRecolor = true
    end

    local vx = (px / cellStuds - pcx) * cellPx
    local vz = (pz / cellStuds - pcz) * cellPx
    local c, s = math.cos(ctx.phi), math.sin(ctx.phi)
    local R = Config.RadarSize / 2
    Plane.Position = UDim2.fromOffset(R - (vx * c - vz * s), R - (vx * s + vz * c))
    Plane.Rotation = math.deg(ctx.phi)
end

----------------------------------------------------------------------
-- WATERMARK + HUD
----------------------------------------------------------------------
local Watermark = newLabel(Root, 14, Vector2.new(0, 0))
Watermark.Position = UDim2.fromOffset(12, 12)
local wmGrad = addGradient(Watermark)

local fps = 60

local function updateHud(ctx, targets)
    local show = Config.Enabled and Config.Radar
    Radar.Visible = show
    if show then
        local size = Config.RadarSize
        if Radar.Size.X.Offset ~= size then Radar.Size = UDim2.fromOffset(size, size) end
        local R = size / 2

        tint(radarStroke, "Color", radarGrad, WHITE, ctx)
        radarGrad.Rotation = Config.Animations and ((ctx.t * 60) % 360) or 0

        local ang = (ctx.t * 2.2) % (math.pi * 2)
        for i, s in ipairs(sweeps) do
            local a = ang - (i - 1) * 0.16
            setLine(s.f, Vector2.new(R, R), Vector2.new(R + math.cos(a) * (R - 2), R + math.sin(a) * (R - 2)), 2)
            s.g.Color = ctx.seq or WHITE_SEQ
        end

        local lv = Camera.CFrame.LookVector
        if math.abs(lv.X) + math.abs(lv.Z) > 1e-3 then
            local vp   = Camera.ViewportSize
            local fovH = 2 * math.atan(math.tan(math.rad(Camera.FieldOfView) / 2) * (vp.X / math.max(vp.Y, 1)))
            local fwd  = math.atan2(lv.Z, lv.X) + ctx.phi
            local c0   = Vector2.new(R, R)
            local col  = ctx.stops and sample(ctx.stops, ctx.phase) or WHITE
            for i, f in ipairs({ fovL, fovR }) do
                local a = fwd + (i == 1 and -1 or 1) * fovH / 2
                setLine(f, c0, c0 + Vector2.new(math.cos(a), math.sin(a)) * R * 1.5, 1)
                f.BackgroundColor3 = col
            end
        else
            fovL.Visible, fovR.Visible = false, false
        end

        northLabel.Position = UDim2.fromOffset(R + math.sin(ctx.phi) * (R - 12), R - math.cos(ctx.phi) * (R - 12))
    end

    Watermark.Visible = Config.Enabled and Config.Watermark
    if Watermark.Visible then
        Watermark.Text = string.format("UNIVERSAL ESP   |   %d FPS   |   %d targets", math.floor(fps + 0.5), targets)
        tint(Watermark, "TextColor3", wmGrad, WHITE, ctx)
        wmGrad.Rotation = Config.Animations and ((ctx.t * 45) % 360) or 0
    end
end

