----------------------------------------------------------------------
getgenv().ESP_Config = Config
getgenv().ESP_Unload = function()
    for _, c in ipairs(conns) do c:Disconnect() end
    for plr in pairs(Objects) do destroyESP(plr) end
    Root:Destroy()
    getgenv().ESP_Unload = nil
end

