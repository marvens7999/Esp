local function worldToScreen(pos)
    local v, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), onScreen, v.Z
end

local function isTeammate(plr)
    return plr.Team ~= nil and plr.Team == LocalPlayer.Team
end

local function staticColor(plr)
    if Config.UseTeamColor and plr.Team then return plr.TeamColor.Color end
    if isTeammate(plr) then return Config.AllyColor end
    return Config.EnemyColor
end

local function tracerStart()
    local vp, o = Camera.ViewportSize, Config.TracerOrigin
    if o == "Center" then return Vector2.new(vp.X / 2, vp.Y / 2) end
    if o == "Top"    then return Vector2.new(vp.X / 2, 0) end
    if o == "Mouse"  then return UserInputService:GetMouseLocation() end
    return Vector2.new(vp.X / 2, vp.Y)
end

local function radarPhi()
    if not Config.RadarRotate then return 0 end
    local lv = Camera.CFrame.LookVector
    if math.abs(lv.X) + math.abs(lv.Z) < 1e-3 then return 0 end
    return -math.pi / 2 - math.atan2(lv.Z, lv.X)
end

