-- periodic palette sampler: x wraps, so animated palettes loop seamlessly
local function sample(stops, x)
    local n = #stops
    local p = (x % 1) * n
    local i = math.floor(p)
    local f = p - i
    return stops[i % n + 1]:Lerp(stops[(i + 1) % n + 1], f)
end

local function currentStops()
    if Config.Theme == "Custom" then return { Config.Custom1, Config.Custom2 } end
    return Themes[Config.Theme] -- nil for "Static"
end

local function buildSeq(stops, phase)
    local N, kps = 12, {}
    for i = 0, N do
        kps[#kps + 1] = ColorSequenceKeypoint.new(i / N, sample(stops, phase + i / N))
    end
    return ColorSequence.new(kps)
end

