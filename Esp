local Objects = {}

local function createESP(plr)
    if plr == LocalPlayer or Objects[plr] then return end
    local o = { phase = math.random(), alpha = 0 }

    o.container = newFrame(Root, { Size = UDim2.fromScale(1, 1), Visible = false })

    o.fill       = newFrame(o.container, { BackgroundTransparency = 0.9, BackgroundColor3 = WHITE })
    o.fillGrad   = addGradient(o.fill)
    o.fillGrad.Rotation = 90
    o.glow       = newFrame(o.container)
    o.glowStroke = addStroke(o.glow, 7)
    o.glowGrad   = addGradient(o.glowStroke)
    o.boxOutline = newFrame(o.container)
    addStroke(o.boxOutline, 3.5, BLACK)
    o.box        = newFrame(o.container)
    o.boxStroke  = addStroke(o.box, 1.5)
    o.boxGrad    = addGradient(o.boxStroke)

    o.corners = {}
    for i = 1, 8 do
        local f = newFrame(o.container, { BackgroundTransparency = 0, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
        addStroke(f, 1, BLACK)
        o.corners[i] = f
    end

    o.name     = newLabel(o.container, Config.TextSize,     Vector2.new(0.5, 1))
    o.nameGrad = addGradient(o.name)
    o.dist     = newLabel(o.container, Config.TextSize - 1, Vector2.new(0.5, 0))
    o.tool     = newLabel(o.container, Config.TextSize - 1, Vector2.new(0.5, 0))
    o.tool.TextColor3 = Color3.fromRGB(255, 225, 120)
    o.hpText   = newLabel(o.container, Config.TextSize - 1, Vector2.new(0, 0))

    o.hpBack = newFrame(o.container, { BackgroundTransparency = 0.2, BackgroundColor3 = BLACK })
    o.hpFill = newFrame(o.hpBack, {
        BackgroundTransparency = 0,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 1, 1, -1),
    })

    o.tracer     = newFrame(o.container, { BackgroundTransparency = 0.1, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5) })
    o.tracerGrad = addGradient(o.tracer)
    o.look       = newFrame(o.container, { BackgroundTransparency = 0.1, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5) })
    o.lookGrad   = addGradient(o.look)

    o.head = newFrame(o.container, { AnchorPoint = Vector2.new(0.5, 0.5) })
    addCorner(o.head)
    o.headStroke = addStroke(o.head, 1.5)
    o.headGrad   = addGradient(o.headStroke)

    o.bones = {}
    for i = 1, MAX_BONES do
        local f = newFrame(o.container, { BackgroundTransparency = 0.05, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
        addStroke(f, 0.8, BLACK)
        o.bones[i] = f
    end

    o.arrow     = newFrame(Root, { Size = UDim2.fromScale(1, 1), Visible = false })
    o.arrowLine = newFrame(o.arrow, { BackgroundTransparency = 0.1, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5) })
    o.arrowDot  = newFrame(o.arrow, { BackgroundTransparency = 0, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5) })
    addCorner(o.arrowDot)
    addStroke(o.arrowDot, 1.5, BLACK)
    o.arrowText = newLabel(o.arrow, Config.TextSize - 1, Vector2.new(0.5, 0.5))

    o.radarDot = newFrame(Radar, { BackgroundTransparency = 0, BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
    addCorner(o.radarDot)
    addStroke(o.radarDot, 1, BLACK)

    o.cham = Instance.new("Highlight")
    o.cham.Name                = "Cham"
    o.cham.OutlineTransparency = 0
    o.cham.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    o.cham.Enabled             = false

    Objects[plr] = o
end

local function hide(o)
    o.container.Visible = false
    o.arrow.Visible     = false
    o.radarDot.Visible  = false
    o.cham.Enabled      = false
    o.alpha             = 0
end

local function destroyESP(plr)
    local o = Objects[plr]
    if not o then return end
    o.container:Destroy()
    o.arrow:Destroy()
    o.radarDot:Destroy()
    o.cham:Destroy()
    Objects[plr] = nil
end

----------------------------------------------------------------------
-- MINIMAP DOT + OFF-SCREEN ARROW
----------------------------------------------------------------------
local function updateRadarDot(o, root, base, ctx)
    if not Config.Radar then o.radarDot.Visible = false return end

    local R   = Config.RadarSize / 2
    local rel = root.Position - ctx.ppos
    local c, s = math.cos(ctx.phi), math.sin(ctx.phi)
    local p = Vector2.new(rel.X * c - rel.Z * s, rel.X * s + rel.Z * c) * (R / Config.RadarRange)

    local lim = R * 0.94
    local m   = math.max(math.abs(p.X), math.abs(p.Y))
    local clamped = m > lim
    if clamped then p = p * (lim / m) end

    local size = Config.Animations and (7 + 1.5 * math.sin(ctx.t * 5 + o.phase * 6.28)) or 7
    o.radarDot.Position = UDim2.fromOffset(R + p.X, R + p.Y)
    o.radarDot.Size = UDim2.fromOffset(size, size)
    o.radarDot.BackgroundColor3 = colorAt(ctx, base, o.phase)
    o.radarDot.BackgroundTransparency = clamped and 0.5 or 0
    o.radarDot.Visible = true
end

local function updateArrow(o, root, base, distance, ctx)
    if not Config.Arrows then o.arrow.Visible = false return end
    local vp  = Camera.ViewportSize
    local rel = Camera.CFrame:PointToObjectSpace(root.Position)
    local dir = Vector2.new(rel.X, -rel.Y)
    if dir.Magnitude < 1e-3 then dir = Vector2.new(0, 1) end
    local u = dir.Unit

    local p = vp / 2 + u * (math.min(vp.X, vp.Y) * Config.ArrowRadius)
    local col = colorAt(ctx, base, o.phase)
    local dot = Config.Animations and (9 + 3 * math.sin(ctx.t * 6 + o.phase * 6.28)) or 10

    o.arrow.Visible = true
    setLine(o.arrowLine, p - u * 20, p, 3)
    o.arrowLine.BackgroundColor3 = col
    o.arrowDot.Position = UDim2.fromOffset(p.X, p.Y)
    o.arrowDot.Size = UDim2.fromOffset(dot, dot)
    o.arrowDot.BackgroundColor3 = col
    o.arrowText.Text = string.format("%dm", math.floor(distance))
    o.arrowText.TextSize = Config.TextSize - 1
    o.arrowText.Position = UDim2.fromOffset(p.X + u.X * 26, p.Y + u.Y * 26)
end

----------------------------------------------------------------------
-- UPDATE
----------------------------------------------------------------------
local function update(plr, o, ctx)
    local char = plr.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not (Config.Enabled and char and hum and root and hum.Health > 0) then return hide(o) end
    if Config.TeamCheck and isTeammate(plr) then return hide(o) end

    local distance = (root.Position - Camera.CFrame.Position).Magnitude
    if distance > Config.MaxDistance then return hide(o) end

    ctx.targets = ctx.targets + 1
    local base = staticColor(plr)

    updateRadarDot(o, root, base, ctx)

    if o.cham.Parent ~= char then o.cham.Parent = char end
    o.cham.Adornee      = char
    o.cham.FillColor    = colorAt(ctx, base, 0)
    o.cham.OutlineColor = colorAt(ctx, base, 0.5)
    local fillT = Config.ChamFill
    if Config.Animations then fillT = fillT + 0.12 * math.sin(ctx.t * 3 + o.phase * 6.28) end
    o.cham.FillTransparency = math.clamp(fillT, 0, 1)
    o.cham.Enabled = Config.Chams

    local rootPos, onScreen, depth = worldToScreen(root.Position)
    if not onScreen or depth <= 0 then
        o.container.Visible = false
        o.alpha = 0
        updateArrow(o, root, base, distance, ctx)
        return
    end
    o.arrow.Visible     = false
    o.container.Visible = true

    o.alpha = math.min(1, o.alpha + ctx.dt * (Config.Animations and 5 or 100))
    local a    = o.alpha
    local ease = 1 - (1 - a) ^ 3
    local tA   = 1 - a

    local topPos    = worldToScreen(root.Position + Vector3.new(0, 3, 0))
    local bottomPos = worldToScreen(root.Position - Vector3.new(0, 3.5, 0))
    local h  = math.abs(bottomPos.Y - topPos.Y)
    local w  = h / 2
    local bx = rootPos.X - w / 2
    local by = topPos.Y

    local sc = Config.Animations and (1.35 - 0.35 * ease) or 1
    local sw, sh = w * sc, h * sc
    local sx, sy = rootPos.X - sw / 2, by + h / 2 - sh / 2
    local pos, size = UDim2.fromOffset(sx, sy), UDim2.fromOffset(sw, sh)

    local showBox = Config.Boxes
    local full    = showBox and Config.BoxStyle ~= "Corners"
    local corners = showBox and Config.BoxStyle == "Corners"
    local spin    = Config.Animations and ((ctx.t * 90) % 360) or 0

    o.fill.Visible = showBox and Config.BoxFill
    if o.fill.Visible then
        o.fill.Position, o.fill.Size = pos, size
        o.fill.BackgroundTransparency = 1 - (1 - Config.FillTransparency) * a
        tint(o.fill, "BackgroundColor3", o.fillGrad, base, ctx)
    end

    o.glow.Visible = showBox and Config.Glow
    if o.glow.Visible then
        o.glow.Position, o.glow.Size = pos, size
        local pulse = Config.Animations and (0.68 + 0.2 * math.sin(ctx.t * 4 + o.phase * 6.28)) or 0.75
        o.glowStroke.Transparency = 1 - (1 - pulse) * a
        o.glowGrad.Rotation = spin
        tint(o.glowStroke, "Color", o.glowGrad, base, ctx)
    end

    o.boxOutline.Visible = full
    o.box.Visible        = full
    if full then
        o.boxOutline.Position, o.boxOutline.Size = pos, size
        o.box.Position, o.box.Size = pos, size
        o.boxStroke.Transparency = tA
        o.boxGrad.Rotation = spin
        tint(o.boxStroke, "Color", o.boxGrad, base, ctx)
    end

    local L = math.min(sw, sh) * 0.28
    local x0, y0, x1, y1 = sx, sy, sx + sw, sy + sh
    local segs = {
        { Vector2.new(x0, y0), Vector2.new(x0 + L, y0) }, { Vector2.new(x0, y0), Vector2.new(x0, y0 + L) },
        { Vector2.new(x1, y0), Vector2.new(x1 - L, y0) }, { Vector2.new(x1, y0), Vector2.new(x1, y0 + L) },
        { Vector2.new(x0, y1), Vector2.new(x0 + L, y1) }, { Vector2.new(x0, y1), Vector2.new(x0, y1 - L) },
        { Vector2.new(x1, y1), Vector2.new(x1 - L, y1) }, { Vector2.new(x1, y1), Vector2.new(x1, y1 - L) },
    }
    for i = 1, 8 do
        local f = o.corners[i]
        if corners then
            setLine(f, segs[i][1], segs[i][2], 2.5)
            f.BackgroundColor3 = colorAt(ctx, base, math.ceil(i / 2) / 4)
            f.BackgroundTransparency = tA
        else
            f.Visible = false
        end
    end

    o.name.Visible = Config.Names
    if Config.Names then
        o.name.Text = (plr.DisplayName ~= plr.Name) and (plr.DisplayName .. " [" .. plr.Name .. "]") or plr.Name
        o.name.TextSize = Config.TextSize
        o.name.Position = UDim2.fromOffset(rootPos.X, by - 4)
        o.name.TextTransparency, o.name.TextStrokeTransparency = tA, tA
        tint(o.name, "TextColor3", o.nameGrad, base, ctx)
    end

    local lineY = by + h + 3
    o.dist.Visible = Config.Distance
    if Config.Distance then
        o.dist.Text = string.format("%dm", math.floor(distance))
        o.dist.TextSize = Config.TextSize - 1
        o.dist.Position = UDim2.fromOffset(rootPos.X, lineY)
        o.dist.TextTransparency, o.dist.TextStrokeTransparency = tA, tA
        lineY = lineY + Config.TextSize + 1
    end
    local tool = Config.Tool and char:FindFirstChildOfClass("Tool")
    o.tool.Visible = tool and true or false
    if tool then
        o.tool.Text = tool.Name
        o.tool.TextSize = Config.TextSize - 1
        o.tool.Position = UDim2.fromOffset(rootPos.X, lineY)
        o.tool.TextTransparency, o.tool.TextStrokeTransparency = tA, tA
    end

    local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    o.hpShown = o.hpShown and (o.hpShown + (frac - o.hpShown) * math.min(ctx.dt * 10, 1)) or frac
    local col = hpColor(frac)
    o.hpBack.Visible = Config.Health
    if Config.Health then
        o.hpBack.Position = UDim2.fromOffset(bx - 7, by - 1)
        o.hpBack.Size = UDim2.fromOffset(4, h + 2)
        o.hpFill.Size = UDim2.fromOffset(2, math.max(math.floor(h * o.hpShown), 0))
        o.hpFill.BackgroundColor3 = col
        o.hpFill.BackgroundTransparency = (Config.Animations and frac < 0.3) and (0.35 + 0.35 * math.sin(ctx.t * 9)) or 0
    end
    o.hpText.Visible = Config.Health and Config.HealthText
    if o.hpText.Visible then
        o.hpText.Text = tostring(math.ceil(hum.Health))
        o.hpText.TextSize = Config.TextSize - 1
        o.hpText.TextColor3 = col
        o.hpText.Position = UDim2.fromOffset(bx + w + 5, by)
        o.hpText.TextTransparency, o.hpText.TextStrokeTransparency = tA, tA
    end

    if Config.Tracers then
        setLine(o.tracer, tracerStart(), Vector2.new(rootPos.X, by + h), 1.5)
        o.tracer.BackgroundTransparency = 0.1 + 0.9 * tA
        tint(o.tracer, "BackgroundColor3", o.tracerGrad, base, ctx)
    else
        o.tracer.Visible = false
    end

    local headPart = char:FindFirstChild("Head")
    if headPart and Config.HeadDot then
        local p = worldToScreen(headPart.Position)
        local r = math.clamp(h / 12, 2, 12)
        o.head.Position = UDim2.fromOffset(p.X, p.Y)
        o.head.Size = UDim2.fromOffset(r * 2, r * 2)
        o.head.Visible = true
        o.headStroke.Transparency = tA
        tint(o.headStroke, "Color", o.headGrad, base, ctx)
    else
        o.head.Visible = false
    end

    o.look.Visible = false
    if headPart and Config.LookDir then
        local p1 = worldToScreen(headPart.Position)
        local p2, _, d2 = worldToScreen(headPart.Position + headPart.CFrame.LookVector * 12)
        if d2 > 0 then
            setLine(o.look, p1, p2, 1.5)
            o.look.BackgroundTransparency = 0.1 + 0.9 * tA
            tint(o.look, "BackgroundColor3", o.lookGrad, base, ctx)
        end
    end

    local bones = (hum.RigType == Enum.HumanoidRigType.R15) and R15_BONES or R6_BONES
    for i = 1, MAX_BONES do
        local line, pair = o.bones[i], bones[i]
        if Config.Skeleton and pair then
            local pa_, pb_ = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
            if pa_ and pb_ then
                local pa, _, da = worldToScreen(pa_.Position)
                local pb, _, db = worldToScreen(pb_.Position)
                if da > 0 and db > 0 then
                    setLine(line, pa, pb, 1.5)
                    line.BackgroundColor3 = colorAt(ctx, base, i / MAX_BONES)
                    line.BackgroundTransparency = 0.05 + 0.95 * tA
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

----------------------------------------------------------------------
-- WIRING
----------------------------------------------------------------------
for _, plr in ipairs(Players:GetPlayers()) do createESP(plr) end

local conns = {}
table.insert(conns, Players.PlayerAdded:Connect(createESP))
table.insert(conns, Players.PlayerRemoving:Connect(destroyESP))

table.insert(conns, UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Config.ToggleKey then
        Config.Enabled = not Config.Enabled
    end
end))

local lastErr
local function report(tag, err)
    if err ~= lastErr then
        lastErr = err
        warn("[ESP] " .. tag .. " error: " .. tostring(err))
    end
end

table.insert(conns, RunService.RenderStepped:Connect(function(dt)
    Camera = Workspace.CurrentCamera
    fps = fps + (1 / math.max(dt, 1e-4) - fps) * 0.1

    local t     = os.clock()
    local stops = currentStops()
    local phase = t * Config.ThemeSpeed

    local lchar = LocalPlayer.Character
    local lroot = lchar and lchar:FindFirstChild("HumanoidRootPart")

    local ctx = {
        t = t, dt = dt, stops = stops, phase = phase,
        seq = stops and buildSeq(stops, phase) or nil,
        targets = 0,
        ppos = lroot and lroot.Position or Camera.CFrame.Position,
        phi = radarPhi(),
    }

    local okMap, errMap = pcall(updateMap, ctx)
    if not okMap then report("map", errMap) end

    for plr, o in pairs(Objects) do
        local ok, err = pcall(update, plr, o, ctx)
        if not ok then
            hide(o)
            report("update", err)
        end
    end

    local okHud, errHud = pcall(updateHud, ctx, ctx.targets)
    if not okHud then report("hud", errHud) end
end))

