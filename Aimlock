-- Delta Aimlock v19 | Roblox (Luau) | Delta executor (No GUI)
-- Unload: getgenv().DeltaAimlockUnload()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

if getgenv and getgenv().DeltaAimlockUnload then
    pcall(getgenv().DeltaAimlockUnload)
end

-- [EDIT 1] Everything starts OFF so nothing runs until the GUI enables it
local Settings = {
    Active = false,
    AimPart = "Head",
    TargetPlayers = false,
    TargetNPCs = false,
    TeamCheck = false,
    WallCheck = false,
    UseFOV = false,
    FOVRadius = 250,
    Smoothing = 0.5,
    MaxDistance = 500,
}

-- [EDIT 1] Share the live table with the GUI (GUI writes into this)
if getgenv then getgenv().Aimlock_Config = Settings end

local MIN_DIST = 2
local MAX_RAYS = 10
local STICKY = 0.7

local Connections = {}
local CurrentPart, CurrentChar = nil, nil
local NPCs = {}

-- ============================== TEAM DETECTION ==============================
local TEAM_KEYS = { "Team", "TeamName", "TeamColor", "TeamID" }

local function GetNpcTeam(model)
    for _, key in ipairs(TEAM_KEYS) do
        local attr = model:GetAttribute(key)
        if attr ~= nil then return tostring(attr):lower() end
        local val = model:FindFirstChild(key)
        if val and val:IsA("ValueBase") then return tostring(val.Value):lower() end
    end
    return nil
end

local function GetLocalTeamKeys()
    local keys = {}
    if LocalPlayer.Team then keys[LocalPlayer.Team.Name:lower()] = true end
    keys[tostring(LocalPlayer.TeamColor):lower()] = true
    for _, key in ipairs(TEAM_KEYS) do
        local attr = LocalPlayer:GetAttribute(key)
        if attr ~= nil then keys[tostring(attr):lower()] = true end
        local char = LocalPlayer.Character
        local cattr = char and char:GetAttribute(key)
        if cattr ~= nil then keys[tostring(cattr):lower()] = true end
    end
    return keys
end

local function IsSameTeam(model, isPlayer, localKeys)
    if not Settings.TeamCheck then return false end
    if isPlayer then
        local player = Players:GetPlayerFromCharacter(model)
        if player and player.Team and LocalPlayer.Team then
            return player.Team == LocalPlayer.Team
        end
        return false
    end
    local npcTeam = GetNpcTeam(model)
    return npcTeam ~= nil and localKeys[npcTeam] == true
end

-- ============================== REGISTRATION ==============================
local function RegisterModel(model)
    if not model or not model:IsA("Model") then return end
    if Players:GetPlayerFromCharacter(model) then return end
    if model == LocalPlayer.Character or model.Name == LocalPlayer.Name then return end
    local cam = workspace.CurrentCamera
    if cam and model:IsDescendantOf(cam) then return end
    if model:FindFirstChildOfClass("Humanoid") then
        NPCs[model] = true
    end
end

for _, inst in ipairs(workspace:GetDescendants()) do
    if inst:IsA("Model") then RegisterModel(inst) end
end

table.insert(Connections, workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("Model") then task.defer(RegisterModel, inst) end
end))

table.insert(Connections, workspace.DescendantRemoving:Connect(function(inst)
    if inst:IsA("Model") then NPCs[inst] = nil end
end))

-- ============================== TARGETING ENGINE ==============================
local function IsAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function GetBestPart(char)
    local head = char:FindFirstChild("Head", true)
    local torso = char:FindFirstChild("Torso", true) or char:FindFirstChild("UpperTorso", true)
    local root = char:FindFirstChild("HumanoidRootPart", true) or char.PrimaryPart

    local list = Settings.AimPart == "Head" and { head, torso, root } or { torso, root, head }
    for _, p in ipairs(list) do
        if p and p:IsA("BasePart") then return p end
    end

    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Transparency < 1 then return desc end
    end
    return nil
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function IsVisible(part, char, camera)
    local origin = camera.CFrame.Position
    local direction = part.Position - origin

    local ignore = { char, camera }
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end

    for _ = 1, 10 do
        rayParams.FilterDescendantsInstances = ignore
        local result = workspace:Raycast(origin, direction, rayParams)
        if not result then return true end

        local inst = result.Instance
        if inst:IsDescendantOf(char) then return true end

        local model = inst:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then
            table.insert(ignore, model)
        elseif inst.Transparency >= 0.9 or not inst.CanCollide then
            table.insert(ignore, inst)
        else
            return false
        end
    end
    return false
end

local function FindTarget(camera)
    local center = camera.ViewportSize / 2
    local camPos = camera.CFrame.Position
    local localKeys = Settings.TeamCheck and GetLocalTeamKeys() or {}
    local scored = {}

    local function consider(char, isPlayer)
        if IsSameTeam(char, isPlayer, localKeys) then return end
        local part = GetBestPart(char)
        if not part then return end

        local pos3 = part.Position
        local dist = (pos3 - camPos).Magnitude
        if dist ~= dist or dist < MIN_DIST or dist > Settings.MaxDistance then return end

        local pos, onScreen = camera:WorldToViewportPoint(pos3)
        if not onScreen then return end

        local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if Settings.UseFOV and screenDist > Settings.FOVRadius then return end

        local score = screenDist
        if char == CurrentChar then score = score * STICKY end
        table.insert(scored, { score = score, part = part, char = char })
    end

    if Settings.TargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and IsAlive(p.Character) then
                consider(p.Character, true)
            end
        end
    end

    if Settings.TargetNPCs then
        for model in pairs(NPCs) do
            if not model.Parent then
                NPCs[model] = nil
            elseif model:IsDescendantOf(camera) then
                NPCs[model] = nil
            elseif IsAlive(model) then
                consider(model, false)
            end
        end
    end

    table.sort(scored, function(a, b) return a.score < b.score end)

    if not Settings.WallCheck then
        local e = scored[1]
        if e then return e.part, e.char end
        return nil, nil
    end

    for i, e in ipairs(scored) do
        if i > MAX_RAYS then break end
        if IsVisible(e.part, e.char, camera) then
            return e.part, e.char
        end
    end
    return nil, nil
end

local function LookCF(from, to)
    local dir = to - from
    if dir.Magnitude < 0.05 or dir.X ~= dir.X or dir.Y ~= dir.Y or dir.Z ~= dir.Z then
        return nil
    end
    local up = Vector3.yAxis
    if math.abs(dir.Unit:Dot(up)) > 0.999 then up = Vector3.zAxis end
    return CFrame.lookAt(from, to, up)
end

-- ============================== FOV CIRCLE [EDIT 3] ==============================
-- Draws the FOV circle on screen. Shown only while Active and UseFOV are ON.
local FOVGui, FOVCircle = nil, nil

pcall(function()
    local parent = (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui")
    FOVGui = Instance.new("ScreenGui")
    FOVGui.Name = "DeltaAimlockFOV"
    FOVGui.ResetOnSpawn = false
    FOVGui.IgnoreGuiInset = true
    FOVGui.DisplayOrder = 999
    FOVGui.Parent = parent

    FOVCircle = Instance.new("Frame")
    FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVCircle.Position = UDim2.fromScale(0.5, 0.5)
    FOVCircle.BackgroundTransparency = 1
    FOVCircle.BorderSizePixel = 0
    FOVCircle.Visible = false
    FOVCircle.Parent = FOVGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = FOVCircle

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(153, 75, 255)
    stroke.Thickness = 1.5
    stroke.Parent = FOVCircle
end)

local function UpdateFOVCircle()
    if not FOVCircle then return end
    local show = Settings.Active and Settings.UseFOV
    FOVCircle.Visible = show == true
    if show then
        local d = Settings.FOVRadius * 2
        FOVCircle.Size = UDim2.fromOffset(d, d)
    end
end

-- ============================== RENDER STEP ==============================
local STEP_NAME = "DeltaAimlockV19"

RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.Last.Value + 1, function(dt)
    local camera = workspace.CurrentCamera
    if not camera then return end

    UpdateFOVCircle() -- [EDIT 3]

    if not Settings.Active then return end

    local part, char = FindTarget(camera)
    if part and char then
        CurrentPart, CurrentChar = part, char

        local camCF = camera.CFrame
        local goal = LookCF(camCF.Position, part.Position)
        if goal then
            local s = math.clamp(Settings.Smoothing, 0.05, 2)
            local alpha = (s >= 1.98) and 1 or (1 - (1 - s / 2) ^ (dt * 60))
            camera.CFrame = camCF:Lerp(goal, alpha)
        end
    else
        CurrentPart, CurrentChar = nil, nil
    end
end)

-- ============================== UNLOAD ==============================
local function Unload()
    pcall(function() RunService:UnbindFromRenderStep(STEP_NAME) end)
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    table.clear(Connections)
    table.clear(NPCs)
    if FOVGui then pcall(function() FOVGui:Destroy() end) end -- [EDIT 3]
    -- [EDIT 2] also clear the shared config on unload
    if getgenv then
        getgenv().DeltaAimlockUnload = nil
        getgenv().Aimlock_Config = nil
    end
end
if getgenv then getgenv().DeltaAimlockUnload = Unload end
